# Copy to .env and adjust. Read by docker compose in this directory.
# Applies to docker-compose.prod.yml ONLY: prod image tag (default: latest;
# pin a released version for reproducible deploys). The dev compose reads
# its own DOCSQL_DEV_IMAGE_TAG (default: local) and is never affected by
# this value.
# DOCSQL_IMAGE_TAG=latest

# Auth token for the server protocol port and the console's node
# connections (docker-compose.prod.yml passes it to every node and the
# web console). The browser UI never carries it: console access is gated
# by the account file (DOCSQL_WEB_AUTH_FILE), and this token is the
# programmatic API bypass. Empty disables node auth — published ports
# default to loopback (127.0.0.1) for exactly that reason; set a strong
# secret before exposing them.
DOCSQL_TOKEN=

# Dev-stack client token (docker-compose.yml reads DOCSQL_DEV_TOKEN, never
# DOCSQL_TOKEN — same separation rule as DOCSQL_DEV_IMAGE_TAG). Handed to
# every dev node and both dev web consoles, which authenticate to nodes
# with it; the browser never fills a token. Optional, but REQUIRED before
# creating database users from the web console: once a node has users,
# anonymous console connections are rejected ("authentication required")
# and the console has no other credential. run-tests.sh scrubs it for
# deterministic tests.
# DOCSQL_DEV_TOKEN=

# Inter-node credential for the cluster profile: nodes authenticate to
# each other with it, and only cluster-authed connections may send
# replication frames (a client logged in with DOCSQL_TOKEN cannot forge
# node traffic). Must match on every node and differ from DOCSQL_TOKEN.
# Empty = legacy behavior (replication shares DOCSQL_TOKEN).
DOCSQL_CLUSTER_TOKEN=

# Address a joining node advertises to the cluster (join profile's
# node-d sets it inside the compose files; only override when adding
# further nodes or changing the network topology).
DOCSQL_ADVERTISE=

# Optional least-privilege credential: connections authenticated with it
# may read and subscribe but not write (SQL writes, PUBLISH, TRIM,
# PROMOTE are refused at the protocol level). Keep distinct from
# DOCSQL_TOKEN. Passed into every node container by both compose files
# (empty = disabled, same as unset).
DOCSQL_READ_TOKEN=

# Resource control: max concurrent connections (0 = unlimited) and idle
# session timeout in seconds (0 = unlimited; subscription clients need
# periodic PING keepalives when set). Passed into every node container
# (empty/unset = server defaults: 1024 connections, no idle timeout).
DOCSQL_MAX_CONN=
DOCSQL_IDLE_TIMEOUT=

# Automatic backups: each node periodically writes a consistent logical SQL
# snapshot (DROP + CREATE + INSERT script) under /data/backups inside its
# own data volume — survive alongside the data, restorable by replaying the
# file into any node (see README「数据持久化」). Interval in seconds
# (default 86400 = daily; 0 disables); keep = snapshots retained per node,
# oldest pruned (default 7).
# DOCSQL_BACKUP_INTERVAL_SECS=86400
# DOCSQL_BACKUP_KEEP=7

# Native data-plane TLS (all nodes together): mount the PEM pair into each
# container (e.g. add "./certs:/certs:ro" to the node's volumes) and set
# the paths below. DOCSQL_TLS_CONNECT=1 dials peers over TLS too;
# DOCSQL_TLS_CA (path inside the container) verifies peer certificates —
# without it the connection is encrypted but unverified. Clients opt in
# with "tls=true" (.NET) / DOCSQL_TLS_CONNECT (CLI, web).
# DOCSQL_TLS_CERT=/certs/cert.pem
# DOCSQL_TLS_KEY=/certs/key.pem
# DOCSQL_TLS_CONNECT=1
# DOCSQL_TLS_CA=/certs/ca.pem
