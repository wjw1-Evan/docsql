# Copy to .env and adjust. Read by docker compose in this directory
# (docker-compose.yml dev default tag is `local`; prod defaults to `latest`).
DOCSQL_IMAGE_TAG=latest

# Auth token for BOTH the server protocol port and the web
# console/REST API (docker-compose.prod.yml passes it to every node).
# Empty disables auth — published ports default to loopback (127.0.0.1)
# for exactly that reason; set a strong secret before exposing them.
DOCSQL_TOKEN=

# Inter-node credential for the cluster profile: nodes authenticate to
# each other with it, and only cluster-authed connections may send
# replication frames (a client logged in with DOCSQL_TOKEN cannot forge
# node traffic). Must match on every node and differ from DOCSQL_TOKEN.
# Empty = legacy behavior (replication shares DOCSQL_TOKEN).
DOCSQL_CLUSTER_TOKEN=

# Address a joining node advertises to the cluster (join profile's
# node-d sets it inside the compose files; only override when adding
# further nodes or changing the network topology).
DOCSQL_ADVERTISE=

# Optional least-privilege credential: connections authenticated with it
# may read and subscribe but not write (SQL writes, PUBLISH, TRIM,
# PROMOTE are refused at the protocol level). Keep distinct from
# DOCSQL_TOKEN.
DOCSQL_READ_TOKEN=

# Resource control: max concurrent connections (0 = unlimited) and idle
# session timeout in seconds (0 = unlimited; subscription clients need
# periodic PING keepalives when set).
DOCSQL_MAX_CONN=0
DOCSQL_IDLE_TIMEOUT=0
