<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging surface (dotnet pack) -->
    <PackageId>Docsql.Client</PackageId>
    <Version>0.9.1</Version>
    <Authors>DocSQL Contributors</Authors>
    <Description>ADO.NET provider for DocSQL: wire-protocol client with token/user authentication, transactions, persistent pub/sub and AES-GCM transport encryption support.</Description>
    <PackageTags>docsql;database;adonet;ado.net;document;sql</PackageTags>
    <RepositoryUrl>https://github.com/wjw1-Evan/docsql</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wjw1-Evan/docsql</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- 嵌入式原生库随包分发(引用即用,SQLite 式体验):发布流水线把
         Releases 的 docsql-native-* 解到 runtimes/<rid>/native/,这里按
         RID 目录原样打进 nupkg —— .NET 的 DllImport 解析器会自动找
         runtimes/<rid>/native/。本地产物未填充该目录时,包内只有托管程序集
         (仓库内开发仍走 target/{debug,release} 回退)。 -->
    <None Include="runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 连接池计数器与 InTransaction 标志为 internal,测试断言池行为用。 -->
    <InternalsVisibleTo Include="Docsql.Client.Tests" />
  </ItemGroup>

</Project>
