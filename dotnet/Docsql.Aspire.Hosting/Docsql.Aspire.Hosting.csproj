<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging surface (dotnet pack) -->
    <PackageId>Docsql.Aspire.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>DocSQL Contributors</Authors>
    <Description>Aspire hosting integration for DocSQL: run DocSQL server nodes and peer clusters as container resources, with token generation, data volumes, TCP health checks, connection string injection and an optional web console resource.</Description>
    <PackageTags>docsql;database;aspire;hosting;document;sql</PackageTags>
    <RepositoryUrl>https://github.com/wjw1-Evan/docsql</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wjw1-Evan/docsql</PackageProjectUrl>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.3" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
  </ItemGroup>

</Project>
