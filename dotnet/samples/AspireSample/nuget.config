<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub Packages 源(四个 Docsql 包在 nuget.org 上不存在)。
  凭据不写入仓库:在用户级 nuget.config 配同名源即可(推荐),
  或按 README 用 dotnet nuget update source 写入本文件。
  完整说明见仓库 README「.NET 与 Aspire」。
-->
<configuration>
  <packageSources>
    <add key="github" value="https://nuget.pkg.github.com/wjw1-Evan/index.json" />
  </packageSources>
</configuration>
