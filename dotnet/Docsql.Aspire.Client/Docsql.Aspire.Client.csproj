<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging surface (dotnet pack) -->
    <PackageId>Docsql.Aspire.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>DocSQL Contributors</Authors>
    <Description>Aspire client integration for DocSQL: registers DocsqlConnection from the connection string injected by the Aspire hosting integration, with a health check.</Description>
    <PackageTags>docsql;database;aspire;client;document;sql</PackageTags>
    <RepositoryUrl>https://github.com/wjw1-Evan/docsql</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wjw1-Evan/docsql</PackageProjectUrl>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docsql.Client\Docsql.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
  </ItemGroup>

</Project>
