# Keep the build context small: docker compose build (deploy/docker-compose.yml
# context: ..) would otherwise ship .git, dotnet build outputs and a
# multi-GB target/ into the daemon on every build.
.git
.gitignore
target
**/target
dotnet/**/bin
dotnet/**/obj
deploy
# Keep only the stream-LB demo image inputs visible (name matches root
# Dockerfile rules: the dockerd.io-unreachable environment builds the LB
# from the azurelinux base via lb.Dockerfile).
!deploy/lb
!deploy/lb.Dockerfile
.github
.mimosa
.zcode
.env
*.md
.dockerignore
